# TWRP user-facing flags and backup options
# Hi Nova 9 Pro (Hebe)

/boot                   emmc    /dev/block/bootdevice/by-name/boot              flags=display="Boot";backup=1;flashimg=1
/recovery               emmc    /dev/block/bootdevice/by-name/recovery          flags=display="Recovery";backup=1;flashimg=1
/vendor_boot            emmc    /dev/block/bootdevice/by-name/vendor_boot       flags=display="Vendor Boot";backup=1;flashimg=1
/dtbo                   emmc    /dev/block/bootdevice/by-name/dtbo              flags=display="DTBO";backup=1;flashimg=1
/vbmeta                 emmc    /dev/block/bootdevice/by-name/vbmeta            flags=display="VBMeta";backup=1;flashimg=1

/system_root            ext4    /dev/block/bootdevice/by-name/system            flags=display="System";backup=0
/vendor                 ext4    /dev/block/bootdevice/by-name/vendor            flags=display="Vendor";backup=0
/hw_product             ext4    /dev/block/bootdevice/by-name/hw_product        flags=display="HW Product";backup=0
/odm                    ext4    /dev/block/bootdevice/by-name/odm               flags=display="ODM";backup=0
/cust                   ext4    /dev/block/bootdevice/by-name/cust              flags=display="Cust";backup=0

/super                  emmc    /dev/block/bootdevice/by-name/super             flags=display="Super Image";backup=1;flashimg=1
/data                   f2fs    /dev/block/bootdevice/by-name/userdata          flags=display="Data";encryptable=footer
/metadata               ext4    /dev/block/bootdevice/by-name/metadata          flags=display="Metadata"
/cache                  ext4    /dev/block/bootdevice/by-name/cache             flags=display="Cache"
/persist                ext4    /dev/block/bootdevice/by-name/persist           flags=display="Persist";backup=1
/firmware               vfat    /dev/block/bootdevice/by-name/modem             flags=display="Firmware";backup=1
/dsp                    ext4    /dev/block/bootdevice/by-name/dsp               flags=display="DSP";backup=1
/bluetooth              vfat    /dev/block/bootdevice/by-name/bluetooth         flags=display="Bluetooth";backup=1
/misc                   emmc    /dev/block/bootdevice/by-name/misc              flags=display="Misc"

# Removable storage
/usb_otg                vfat    /dev/block/sdg1         /dev/block/sdg          flags=display="USB-OTG";storage;wipeingui;removable
/external_sd            vfat    /dev/block/mmcblk1p1    /dev/block/mmcblk1      flags=display="Micro SD Card";storage;wipeingui;removable
